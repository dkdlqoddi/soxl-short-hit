//@version=6
indicator("bench loop", overlay=false)
n = input.int(2000, "N per bar")
var float[] a = array.new<float>(256, 0.0)
var int firstT = na
if barstate.isfirst
    firstT := time
float acc = 0.0
for i = 0 to n - 1
    j = i % 256
    float v = array.get(a, j)
    if v > close
        array.set(a, j, v * 0.5)
    else
        array.set(a, j, v + 1.0)
acc := array.sum(a)
plot(acc)
if barstate.islast
    log.info("BENCH bars={0} n={1} first={2} last={3} sum={4}", bar_index + 1, n, str.format_time(firstT, "yyyy-MM-dd HH:mm", "America/New_York"), str.format_time(time, "yyyy-MM-dd HH:mm", "America/New_York"), acc)
